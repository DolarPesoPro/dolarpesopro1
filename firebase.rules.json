{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'"
    },
    "history": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'"
    },
    "alerts": {
      ".read": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
      "$id": {
        ".write": "(auth != null && auth.token.email == 'admin@dolarpesopro.app') || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['phone','target','at'])",
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 20"
        },
        "target": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100000"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "started": {
          ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app' || (newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1)",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "done": {
          ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}