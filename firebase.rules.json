{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": "auth != null && auth.token.email == 'admin@dolarpesopro.app' || !root.child('status').exists() || root.child('status/mode').val() == 'on' || (root.child('status/mode').val() == 'auto' && ((root.child('status/fromMin').val() <= root.child('status/toMin').val() && ((now + 75600000) % 86400000) / 60000 >= root.child('status/fromMin').val() && ((now + 75600000) % 86400000) / 60000 < root.child('status/toMin').val()) || (root.child('status/fromMin').val() > root.child('status/toMin').val() && (((now + 75600000) % 86400000) / 60000 >= root.child('status/fromMin').val() || ((now + 75600000) % 86400000) / 60000 < root.child('status/toMin').val()))))",
      ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
      "offReason": {
        ".validate": "newData.isString() && newData.val().length <= 120"
      }
    },
    "history": {
      ".read": "auth != null && auth.token.email == 'admin@dolarpesopro.app' || !root.child('status').exists() || root.child('status/mode').val() == 'on' || (root.child('status/mode').val() == 'auto' && ((root.child('status/fromMin').val() <= root.child('status/toMin').val() && ((now + 75600000) % 86400000) / 60000 >= root.child('status/fromMin').val() && ((now + 75600000) % 86400000) / 60000 < root.child('status/toMin').val()) || (root.child('status/fromMin').val() > root.child('status/toMin').val() && (((now + 75600000) % 86400000) / 60000 >= root.child('status/fromMin').val() || ((now + 75600000) % 86400000) / 60000 < root.child('status/toMin').val()))))",
      ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'"
    },
    "alerts": {
      ".read": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
      "$id": {
        ".write": "(auth != null && auth.token.email == 'admin@dolarpesopro.app') || (!data.exists() && newData.exists())",
        ".validate": "$id.matches(/^[-A-Za-z0-9_]{1,40}$/) && newData.hasChildren(['phone','target','at'])",
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8,15}$/)"
        },
        "target": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 100000"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "notifyOpen": {
      ".read": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
      "$id": {
        ".write": "(auth != null && auth.token.email == 'admin@dolarpesopro.app') || (!data.exists() && newData.exists())",
        ".validate": "$id.matches(/^[-A-Za-z0-9_]{1,40}$/) && newData.hasChildren(['phone','at'])",
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8,15}$/)"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reviews": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
        ".validate": "newData.hasChildren(['name','text','stars','at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "place": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "stars": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "stats": {
      ".read": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
      "$day": {
        ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
        "started": {
          ".write": "(auth != null && auth.token.email == 'admin@dolarpesopro.app') || (newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000"
        },
        "done": {
          ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "status": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@dolarpesopro.app'",
      ".validate": "newData.hasChildren(['mode','fromMin','toMin'])",
      "mode": {
        ".validate": "newData.isString() && (newData.val() == 'on' || newData.val() == 'off' || newData.val() == 'auto')"
      },
      "offReason": {
        ".validate": "newData.isString() && newData.val().length <= 120"
      },
      "hoursFrom": {
        ".validate": "newData.isString() && newData.val().length <= 5"
      },
      "hoursTo": {
        ".validate": "newData.isString() && newData.val().length <= 5"
      },
      "fromMin": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440"
      },
      "toMin": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440"
      },
      "onlineAt": {
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}